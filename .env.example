# Copy this file to .env and replace the values for your environment.
# Compose는 이 파일을 /app/config/.env에 읽기 전용으로 마운트한다.
APP_UID=1000
MEETBACK_ENV_FILE=./.env
MYSQL_ROOT_PASSWORD_FILE=./secrets/mysql_root_password

# DB_NAME/DB_USERNAME은 로컬 실행용이며 Compose에서는 meet_back/meetback으로 고정한다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=meet_back
DB_USERNAME=meetback
DB_PASSWORD=
APP_PORT=8080

KAKAO_REST_API_KEY=
ODSAY_API_KEY=
ODSAY_BASE_URL=http://10.7.0.40/v1/api

JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_SOCIAL_SIGNUP_TOKEN_EXPIRATION=600000
JWT_PASSWORD_RESET_TOKEN_EXPIRATION=900000

KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=
KAKAO_CLIENT_SECRET=

# Google Identity Services web client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

NAVER_MAPS_CLIENT_ID=your-naver-client-id
NAVER_MAPS_CLIENT_SECRET=your-naver-client-secret

APP_BASE_URL=http://localhost:8080
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
