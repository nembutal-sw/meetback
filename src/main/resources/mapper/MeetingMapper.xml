<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.meetback.dev.repository.MeetingMapper">

    <select id="findById"
            resultType="com.meetback.dev.domain.Meeting">

        SELECT *
        FROM meetings
        WHERE meeting_id = #{meetingId}

    </select>

</mapper>