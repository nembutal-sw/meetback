<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.meetback.dev.repository.FeedMapper">


    <!-- =========================================================
         Feed ResultMap
         ========================================================= -->

    <resultMap id="feedResultMap"
               type="com.meetback.dev.domain.Feed">

        <id property="feedId"
            column="feed_id"/>

        <result property="userId"
                column="user_id"/>

        <result property="nickname"
                column="nickname"/>

        <result property="title"
                column="title"/>

        <result property="content"
                column="content"/>

        <result property="deletedAt"
                column="deleted_at"/>

        <result property="createdAt"
                column="created_at"/>

        <result property="updatedAt"
                column="updated_at"/>

    </resultMap>


    <!-- =========================================================
         피드 등록
         ========================================================= -->

    <insert id="insert"
            parameterType="com.meetback.dev.domain.Feed"
            useGeneratedKeys="true"
            keyProperty="feedId">

        INSERT INTO feeds
        (
            user_id,
            title,
            content,
            deleted_at,
            created_at,
            updated_at
        )
        VALUES
        (
            #{userId},
            #{title},
            #{content},
            NULL,
            NOW(),
            NOW()
        )

    </insert>


    <!-- =========================================================
         피드 단건 조회 + 작성자 닉네임
         ========================================================= -->

    <select id="findById"
            resultMap="feedResultMap">

        SELECT
        feeds.feed_id,
            feeds.user_id,
            users.nickname,
            feeds.title,
            feeds.content,
            feeds.deleted_at,
            feeds.created_at,
            feeds.updated_at
        FROM feeds
        LEFT JOIN users
            ON feeds.user_id = users.user_id
            WHERE feeds.feed_id = #{feedId}
            AND feeds.deleted_at IS NULL

    </select>


    <!-- =========================================================
         기존 피드 전체 조회
         ========================================================= -->

    <select id="findAll"
            resultMap="feedResultMap">

        SELECT
            feeds.feed_id,
            feeds.user_id,
            users.nickname,
            feeds.title,
            feeds.content,
            feeds.deleted_at,
            feeds.created_at,
            feeds.updated_at
        FROM feeds
        LEFT JOIN users
            ON feeds.user_id = users.user_id
            WHERE feeds.deleted_at IS NULL
            ORDER BY
            feeds.created_at DESC,
            feeds.feed_id DESC

    </select>


    <!-- =========================================================
         피드 페이징 조회
         ========================================================= -->

    <select id="findPage"
            resultMap="feedResultMap">

        SELECT
            feeds.feed_id,
            feeds.user_id,
            users.nickname,
            feeds.title,
            feeds.content,
            feeds.deleted_at,
            feeds.created_at,
            feeds.updated_at
        FROM feeds
        LEFT JOIN users
            ON feeds.user_id = users.user_id
            WHERE feeds.deleted_at IS NULL
            ORDER BY
            feeds.created_at DESC,
            feeds.feed_id DESC
            LIMIT #{size}
            OFFSET #{offset}

    </select>


    <!-- =========================================================
         전체 피드 개수
         ========================================================= -->

    <select id="countAll"
            resultType="java.lang.Long">

        SELECT COUNT(*)
        FROM feeds
        WHERE deleted_at IS NULL

    </select>


    <!-- =========================================================
         피드 수정
         ========================================================= -->

    <update id="update"
            parameterType="com.meetback.dev.domain.Feed">

        UPDATE feeds
        SET
            title = #{title},
            content = #{content},
            updated_at = NOW()
            WHERE feed_id = #{feedId}
            AND user_id = #{userId}
            AND deleted_at IS NULL

    </update>


    <!-- =========================================================
         피드 Soft Delete
         ========================================================= -->

    <update id="softDelete">

        UPDATE feeds
        SET
            deleted_at = NOW(),
            updated_at = NOW()
            WHERE feed_id = #{feedId}
            AND user_id = #{userId}
            AND deleted_at IS NULL

    </update>


</mapper>