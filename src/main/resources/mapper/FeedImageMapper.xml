<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.meetback.dev.repository.FeedImageMapper">


    <!-- =========================================================
         FeedImage ResultMap
         ========================================================= -->

    <resultMap id="feedImageResultMap"
               type="com.meetback.dev.domain.FeedImage">

        <id property="feedImageId"
            column="feed_image_id"/>

        <result property="feedId"
                column="feed_id"/>

        <result property="imageUrl"
                column="image_url"/>

        <result property="originalName"
                column="original_name"/>

        <result property="storedName"
                column="stored_name"/>

        <result property="sortOrder"
                column="sort_order"/>

        <result property="createdAt"
                column="created_at"/>

    </resultMap>


    <!-- =========================================================
         이미지 등록
         ========================================================= -->

    <insert id="insert"
            parameterType="com.meetback.dev.domain.FeedImage"
            useGeneratedKeys="true"
            keyProperty="feedImageId">

        INSERT INTO feed_images
        (
            feed_id,
            image_url,
            original_name,
            stored_name,
            sort_order,
            created_at
        )
        VALUES
        (
            #{feedId},
            #{imageUrl},
            #{originalName},
            #{storedName},
            #{sortOrder},
            NOW()
        )

    </insert>


    <!-- =========================================================
         피드 이미지 조회
         ========================================================= -->

    <select id="findByFeedId"
            resultMap="feedImageResultMap">

        SELECT
            feed_image_id,
            feed_id,
            image_url,
            original_name,
            stored_name,
            sort_order,
            created_at
        FROM feed_images
        WHERE feed_id = #{feedId}
        ORDER BY
            sort_order ASC,
            feed_image_id ASC

    </select>


    <!-- =========================================================
         특정 이미지 삭제
         ========================================================= -->

    <delete id="deleteByIdAndFeedId">

        DELETE FROM feed_images
        WHERE feed_image_id = #{feedImageId}
        AND feed_id = #{feedId}

    </delete>


    <!-- =========================================================
         특정 피드 이미지 전체 삭제
         기존 기능 유지
         ========================================================= -->

    <delete id="deleteByFeedId">

        DELETE FROM feed_images
        WHERE feed_id = #{feedId}

    </delete>


</mapper>