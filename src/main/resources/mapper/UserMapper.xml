<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.meetback.dev.repository.UserMapper">

    <resultMap id="userResultMap"
               type="com.meetback.dev.domain.User">

        <id property="userId" column="user_id"/>

        <result property="email" column="email"/>

        <result property="nickname" column="nickname"/>

        <result property="passwordHash" column="password_hash"/>

        <result property="role" column="role"/>

        <result property="tokenVersion" column="token_version"/>

        <result property="deletedAt" column="deleted_at"/>

        <result property="createdAt" column="created_at"/>

        <result property="updatedAt" column="updated_at"/>

    </resultMap>


    <!-- 회원가입 -->
    <insert id="insertUser"
            parameterType="com.meetback.dev.domain.User"
            useGeneratedKeys="true"
            keyProperty="userId">

        INSERT INTO users
        (
        email,
            nickname,
            password_hash,
            created_at,
            updated_at
        )
        VALUES
        (
            #{email},
            #{nickname},
            #{passwordHash},
        NOW(),
        NOW()
        )

    </insert>


    <!-- 이메일 중복 검사 -->
    <select id="existByEmail"
            resultType="int">

        SELECT COUNT(*)
        FROM users
        WHERE email = #{email}

    </select>


    <!-- 닉네임 중복 검사 -->
    <select id="existByNickname"
            resultType="int">

        SELECT COUNT(*)
        FROM users
        WHERE nickname = #{nickname}

    </select>


    <!-- 이메일 회원 조회 -->
    <select id="selectByEmail"
            resultMap="userResultMap">

        SELECT
            user_id,
            email,
            nickname,
            password_hash,
            role,
            token_version,
            deleted_at,
            created_at,
            updated_at
        FROM users
        WHERE email = #{email}

    </select>


    <!-- 닉네임 회원 조회 -->
    <select id="selectByNickname"
            resultMap="userResultMap">

        SELECT
            user_id,
            email,
            nickname,
            password_hash,
            role,
            token_version,
            deleted_at,
            created_at,
            updated_at
        FROM users
        WHERE nickname = #{nickname}

    </select>


    <!-- UserId 회원 조회 -->
    <select id="selectById"
            resultMap="userResultMap">

        SELECT
            user_id,
            email,
            nickname,
            password_hash,
            role,
            token_version,
            deleted_at,
            created_at,
            updated_at
        FROM users
        WHERE user_id = #{userId}

    </select>


    <!-- 회원탈퇴 -->
    <update id="withdrawUser">

        UPDATE users
        SET deleted_at = NOW(),
        updated_at = NOW()
        WHERE user_id = #{userId}

    </update>


    <!-- 회원탈퇴 취소 -->
    <update id="cancelWithdrawal">

        UPDATE users
        SET deleted_at = NULL,
        updated_at = NOW()
        WHERE user_id = #{userId}

    </update>


    <!-- Token Version 증가 -->
    <update id="increaseTokenVersion">

        UPDATE users
        SET token_version = token_version + 1,
        updated_at = NOW()
        WHERE user_id = #{userId}

    </update>


    <!-- 비밀번호 변경 -->
    <update id="updatePassword">

        UPDATE users
        SET password_hash = #{passwordHash},
             updated_at = NOW()
        WHERE user_id = #{userId}

    </update>

</mapper>